<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net481</TargetFrameworks>
    <RootNamespace>DynamoPilot.Server</RootNamespace>
    <AssemblyName>PilotServerNodes</AssemblyName>
    <AssemblyProduct>PilotServerNodes</AssemblyProduct>
    <Product>PilotServerNodes</Product>
    <Description>Dynamo nodes for Pilot server API</Description>
    <AssemblyVersion>0.0.0.2</AssemblyVersion>
    <LangVersion>10.0</LangVersion>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <OutputType>Library</OutputType>
    <BaseOutputPath>..\bin\</BaseOutputPath>
    <AppData>$(USERPROFILE)\AppData\Local</AppData>
    <UserDirectoryPathBIM>$(AppData)\ASCON\Pilot-BIM\Development\DynamoPilot.App\packages\DynamoPilot\bin</UserDirectoryPathBIM>
    <UserDirectoryPathICE>$(AppData)\ASCON\Pilot-ICE Enterprise\Development\DynamoPilot.App\packages\DynamoPilot\bin</UserDirectoryPathICE>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)'=='net481'">
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ascon.Pilot.Server.Api" Version="25.9.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)'=='net481'">
    <PackageReference Include="DynamoVisualProgramming.Core" Version="2.16.4.10216" />
    <PackageReference Include="DynamoVisualProgramming.WpfUILibrary" Version="2.16.4.10216" />
  </ItemGroup>

  <Target Name="CopyToDebugDirectory" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug' and '$(TargetFramework)' == 'net481'">
    <MakeDir Directories="$(UserDirectoryPathBIM)" Condition="!Exists('$(UserDirectoryPathBIM)')" />
    <MakeDir Directories="$(UserDirectoryPathICE)" Condition="!Exists('$(UserDirectoryPathICE)')" />

    <ItemGroup>
      <FilesToCopy Include="$(TargetDir)$(AssemblyName).dll;$(TargetDir)$(AssemblyName).pdb;$(TargetDir)$(AssemblyName).xml" />
    </ItemGroup>

    <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(UserDirectoryPathBIM)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(UserDirectoryPathICE)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CreateZip" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="powershell -Command &quot;Compress-Archive -Path $(OutputPath)$(AssemblyName).dll -DestinationPath $(OutputPath)..\$(AssemblyProduct).zip -Force&quot;" />
  </Target>

</Project>

