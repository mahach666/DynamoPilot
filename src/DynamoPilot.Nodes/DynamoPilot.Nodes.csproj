<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{b27f603b-8896-454c-9094-e1628281320e}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>DynamoPilot.Nodes</RootNamespace>
    <AssemblyName>DynamoPilot.Nodes</AssemblyName>
    <TargetFramework>net481</TargetFramework>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <AssemblyProduct>DynamoPilot.Nodes</AssemblyProduct>
    <Product>DynamoPilot.Nodes</Product>
    <Description>DynamoPilot.Nodes</Description>
    <AssemblyVersion>0.0.0.2</AssemblyVersion>
    <UseWPF>true</UseWPF>
    <LangVersion>10.0</LangVersion>

    <!-- Не копируем зависимости NuGet в папку вывода -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
    <StartAction>Program</StartAction>
    <StartProgram>C:\Program Files\ASCON\Pilot-BIM\Ascon.Pilot.PilotBIM.exe</StartProgram>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!-- Пути к папкам для дебага -->
  <PropertyGroup>
    <AppData>$(USERPROFILE)\AppData\Local</AppData>
    <UserDirectoryPathBIM>$(AppData)\ASCON\Pilot-BIM\Development\DynamoPilot.App\packages\DynamoPilot\bin</UserDirectoryPathBIM>
    <UserDirectoryPathICE>$(AppData)\ASCON\Pilot-ICE Enterprise\Development\DynamoPilot.App\packages\DynamoPilot\bin</UserDirectoryPathICE>
    <BaseOutputPath>..\bin\</BaseOutputPath>
  </PropertyGroup>

  <!-- Копируем все библиотеки для отладки -->
  <Target Name="CopyToDebugDirectory" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <MakeDir Directories="$(UserDirectoryPathBIM)" Condition="!Exists('$(UserDirectoryPathBIM)')" />
    <MakeDir Directories="$(UserDirectoryPathICE)" Condition="!Exists('$(UserDirectoryPathICE)')" />

    <ItemGroup>
      <FilesToCopy Include="$(OutputPath)*.dll;$(OutputPath)*.pdb;$(OutputPath)*.xml" />
    </ItemGroup>

    <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(UserDirectoryPathBIM)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FilesToCopy)" DestinationFolder="$(UserDirectoryPathICE)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Создаём архив пакета DynamoPilot с правильной структурой -->
  <Target Name="CreateZip" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageTempDir>$(OutputPath)..\DynamoPilot</PackageTempDir>
      <PackageBinDir>$(PackageTempDir)\bin</PackageBinDir>
    </PropertyGroup>
    
    <!-- Удаляем старую временную папку если есть -->
    <RemoveDir Directories="$(PackageTempDir)" />
    
    <!-- Создаём структуру папок пакета -->
    <MakeDir Directories="$(PackageBinDir)" />
    
    <!-- Копируем pkg.json в корень пакета -->
    <Copy SourceFiles="$(ProjectDir)pkg.json" DestinationFolder="$(PackageTempDir)" />
    
    <!-- Копируем dll, pdb, xml в bin/ -->
    <ItemGroup>
      <BinFiles Include="$(OutputPath)*.dll;$(OutputPath)*.pdb;$(OutputPath)*.xml" />
    </ItemGroup>
    <Copy SourceFiles="@(BinFiles)" DestinationFolder="$(PackageBinDir)" />
    
    <!-- Создаём архив -->
    <Exec Command="powershell -Command &quot;Compress-Archive -Path '$(PackageTempDir)' -DestinationPath '$(OutputPath)..\DynamoPilot.zip' -Force&quot;" />
    
    <!-- Удаляем временную папку -->
    <RemoveDir Directories="$(PackageTempDir)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Ascon.Pilot.SDK" Version="26.1.0" />
    <PackageReference Include="Ascon.Pilot.Server.Api" Version="26.1.0" />
    <PackageReference Include="DynamoVisualProgramming.Core" Version="2.16.4.10216" />
    <PackageReference Include="DynamoVisualProgramming.WpfUILibrary" Version="2.16.4.10216" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DynamoPilot.Data\DynamoPilot.Data.csproj" Private="False" />
    <ProjectReference Include="..\DynamoPilot.Server\DynamoPilot.Server.csproj" />
    <ProjectReference Include="..\DynamoPilot.Zero\DynamoPilot.Zero.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.ComponentModel.Composition" />
  </ItemGroup>

</Project>